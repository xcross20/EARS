# Local demo session signing key. Copy this file to .env.local and replace the value.
# The placeholder below is rejected at startup. Use at least 16 characters.
# This is not a credential for any real system.
EARS_DEMO_SESSION_SECRET=replace-this-local-secret

# Optional. Set to 1 only when exercising loading and error states in tests.
# Leave unset for ordinary local use.
EARS_ALLOW_DEMO_FAULTS=

# Optional. When unset, Run AI review uses the deterministic evidence draft.
# Never commit a real key. The server reads this. The browser does not.
XAI_API_KEY=
